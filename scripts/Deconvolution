##Load functions
Convert_To_ENSG2 <- function(df) {
  gene_info <- read.csv("~/Library/CloudStorage/OneDrive-AdventHealth/Clincial Studies Projects/Points/deconvolution/gene_info_incl_introns.csv")
  gene_info <- gene_info %>%
    dplyr::select(2, 3)  ##subset to only relevant columns
  df <- dplyr::left_join(df, gene_info, by = c("Gene_Name"))
  Ensemble_ID <- df$Ensembl_ID  ###Remove columns with Gene_ID and Gene_name
  return(Ensemble_ID)
}

###Load required functions
remove_duplicate_genes<-function(eset, column_of_symbol, method = "mean"){
  eset<-as.data.frame(eset)
  rownames(eset)<-NULL
  dups <- dim(eset)[1] - length(unique(eset[,column_of_symbol]))
  if(dups==0){
    eset<-tibble:: column_to_rownames(eset,var = column_of_symbol)
    return(eset)
  }else{
    if(method=="mean"){
      order_index=apply(eset[,setdiff(colnames(eset),column_of_symbol)],1,function(x) mean(x,na.rm=T))
      eset<-eset[order(order_index,decreasing=T),]
      eset<-eset %>%dplyr:: distinct(!!sym(column_of_symbol),.keep_all = TRUE) %>%
        tibble:: column_to_rownames(.,var = column_of_symbol)
      return(eset)
    }else if(method == "sd"){
      order_index = apply(eset[,setdiff(colnames(eset),column_of_symbol)],1,function(x) sd(x,na.rm=T))
      eset<-eset[order(order_index,decreasing=T),]
      eset<-eset %>% distinct(!!sym(column_of_symbol),.keep_all = TRUE) %>%
        tibble:: column_to_rownames(.,var = column_of_symbol)
      return(eset)
    }
  }
}

Convert_To_ENSG <- function(df) {
  gene_info <- read.csv("~/Library/CloudStorage/OneDrive-AdventHealth/Clincial Studies Projects/Points/deconvolution/gene_info_incl_introns.csv")
  gene_info <- gene_info %>%
    dplyr::select(2, 3)  ##subset to only relevant columns
  df$Gene_Name <- rownames(df)
  df <- dplyr::left_join(df, gene_info, by = c("Gene_Name"))
  df <- remove_duplicate_genes(df, column_of_symbol = 'Gene_Name', method = 'mean') ##remove duplicate genes that have the same symbol based on which one has the greatest mean 
  rownames(df) <- df$Ensembl_ID  ##make ENSG rownames
  sum(duplicated(df$Gene_ID))
  df$Gene_ID[duplicated(sig$Gene_ID)]
  df <- subset(df, select = -c(Ensembl_ID))  ###Remove columns with Gene_ID and Gene_name
}



seurat <- readRDS('~/Library/CloudStorage/OneDrive-AdventHealth/Points/Data/Integration/Points.harmony.sct.RDS')
Idents(seurat) = seurat$CellType2


###Create signature matrix for all cell types using filtered assay and normalized data
##Skip this step if already completed

DefaultAssay(object = seurat) <- "filtered"
seurat <- NormalizeData(seurat)
all.genes <- rownames(seurat)
seurat <- ScaleData(seurat, features = all.genes)

Sig_matrix <- AggregateExpression(seurat, return.seurat = FALSE, assay = 'filtered', slot = 'data', group.by = "CellType2")
Sig_matrix <- Sig_matrix$filtered
dim(Sig_matrix)
Sig_matrix[1:6, 1:6]
write.csv(Sig_matrix, 'Points.signature.matrix.normalized.csv')


merge.list <- SplitObject(seurat, split.by="orig.ident")
merge.list <- lapply(X = merge.list, 
                     FUN = SCTransform, 
                     method = "glmGamPoi", 
                     return.only.var.genes = FALSE)


Gene_Name <- SelectIntegrationFeatures(object.list = merge.list, nfeatures = 5000)
df <- as.data.frame(Gene_Name)
df <- Convert_To_ENSG2(df)
write.csv(df, "5000HVG.points.csv")
write.csv(Gene_Name, '5000HVG.gene.name.points.csv')

##Load the signature matrix, this is currently unfiltered
sig <- read.csv("Points.signature.matrix.normalized.csv", row.names = 1)
