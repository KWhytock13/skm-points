##run dtangle on TRIM
counts <- read.csv("datasets/GSE175495_Muscle_simple_counts.csv", header = TRUE,   row.names = 1)
counts[1:6, 1:6]
str(counts)
#counts <- as.matrix(counts)

# Convert to CPM
cpm_counts <- cpm(counts)
cpm_counts[1:6, 1:6]

colnames(cpm_counts)

colnames(cpm_counts)
colnames(cpm_counts) <- gsub("_+sorted\\.bam$", "", colnames(cpm_counts))

filtered_counts <- cpm_counts[rowMeans(cpm_counts == 0) < 0.5, ]

mat <- as.matrix(filtered_counts)

##sig matrix
sig <- read.csv("Points.signature.matrix.normalized.csv", row.names = 1)
head(sig)
sig[1:8, 1:8]

hvg5000 <- read.csv("5000HVG.gene.name.points.csv", row.names = 1)
hvg5000s <- hvg5000$x 

sig5 <- sig[rownames(sig) %in% hvg5000s, ]
sig5 <-  as.matrix(sig5)
dim(sig5)
sig5[1:6, 1:6]



###Run deconvolution
decon <- deconvolute(m = mat, sigMatrix = sig5, methods = c("dtangle"))
str(decon)

##get proportions
props <- decon$proportions$dtangle_sig1
props
str(props)
props$MYH7B_EGF <- props$MYH7B..Myonuclei/props$EGF..Myonuclei
props$sample <- rownames(props)
props.long <- props %>% pivot_longer(cols = CKM..Myonuclei:MYH7B_EGF, names_to = 'Nuclei_Type', values_to = 'value' )
head(props.long)
props.long$sample

props.long <- props.long %>%
  mutate(age_group = case_when(
    str_starts(sample, "Old") ~ "Older",
    str_starts(sample, "Young") ~ "Younger",
    TRUE ~ NA_character_
  ))

##extract just MYH7B and MYH7b_EGF seperately
ggplot(props.long, aes(x=Nuclei_Type, y=value, fill=age_group)) +
  geom_boxplot()

df.wide <- pivot_wider(props.long, names_from = Nuclei_Type, values_from = value)

variables <- colnames(df.wide[3:11])

df.wide %>% shapiro_test(variables)

t.test <- props.long %>%
  group_by(Nuclei_Type) %>%
  t_test(value ~ age_group, var.equal = TRUE) %>%
  add_significance()
t.test

MYH7B_EGF <- subset(props.long, Nuclei_Type == 'MYH7B_EGF' )

##subset to just MYH7B/EGF and plot out 
my_dat <- summarise(group_by(MYH7B_EGF, age_group),
                    my_mean = mean(value, na.rm = TRUE),
                    my_se = std.error(value, na.rm = TRUE))


MYH7B_EGF$age_group <- factor(MYH7B_EGF$age_group, levels = c('Younger', 'Older'))
my_dat$age_group <- factor(my_dat$age_group, levels = c('Younger', 'Older'))


plot1 <- ggplot() + 
  geom_bar(data = my_dat,
           aes(y = my_mean, x = age_group, fill = age_group, 
               ymin = my_mean - my_se,
               ymax = my_mean + my_se), position = "dodge", stat="identity", width=0.75) +
  scale_fill_manual(values=c("purple",
                             "orange"))+ 
  geom_errorbar(data = my_dat,
                aes(y = my_mean, x = age_group, fill = age_group, 
                    ymin = my_mean - my_se,
                    ymax = my_mean + my_se), stat="identity",  position = "dodge", width=0.75) + 
  geom_jitter(data = MYH7B_EGF, aes(age_group, value, fill = age_group), shape = 21, color = "black",
              position = position_jitterdodge(jitter.height = .1, jitter.width = .2)) +
  labs(y = "Ratio of MYH7B+/EGF+ Myonuclei", x = "", fill = "") + my_theme + ylim(0, 10) +
  annotate("segment", x = 1, xend = 2, y = 9, yend = 9,
           colour = "black") +
  annotate("text", label = '*', x = 1.5, y = 10, size =8,
           colour = "black") 


ggsave(
  filename = "Figures/TRIM_MYH7BtoEGF.pdf",
  plot = plot1,
  device = pdf,
  path = NULL,
  scale = 1,
  width = 10,
  height = 10,
  units = c("cm"),
  dpi = 300,
  limitsize = TRUE,
  bg = NULL,
  create.dir = FALSE
)

