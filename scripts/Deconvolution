sig[1:8, 1:8]

sig <- Convert_To_ENSG(sig)

hvg5000 <- read.csv("5000HVG.points.csv", row.names = 1)
hvg5000s <- hvg5000$x 

sig5 <- sig[rownames(sig) %in% hvg5000s, ]
