seurat <- readRDS('Integration/Points.harmony.sct.RDS')

Idents(seurat) = seurat$cluster_id

levels <- c('EGF+ Myonuclei', 'CKM+ Myonuclei',  'MYH7B+ Myonuclei', 'MuSC', 'FAP', 'SMC.Pericytes', 'EC', 'Immune')
levels(seurat) <- levels

DefaultAssay(object = seurat) <- "filtered"
seurat <- NormalizeData(seurat)
all.genes <- rownames(seurat)
seurat <- ScaleData(seurat, features = all.genes)


###Edit metadata col names so it matches what is used in tutorial
names(seurat@meta.data)[names(seurat@meta.data) == "orig.ident"] <- "sample_id"
names(seurat@meta.data)[names(seurat@meta.data) == "Group"] <- "group_id"

# Extract raw counts and metadata to create SingleCellExperiment object
counts <- seurat@assays$filtered@counts 

metadata <- seurat@meta.data

# Set up metadata as desired for aggregation and DE analysis

metadata$cluster_id <- factor(seurat@active.ident)

# Create single cell experiment object
sce <- SingleCellExperiment(assays = list(counts = counts), 
                            colData = metadata)

# Identify groups for aggregation of counts
groups <- colData(sce)[, c("cluster_id", "sample_id")]

# Explore the raw counts for the dataset

## Check the assays present
assays(sce)

## Explore the raw counts for the dataset
dim(counts(sce))
counts(sce)[1:6, 1:6]

#Named vector of cluster names
kids <- purrr::set_names(levels(sce$cluster_id))
#kids <- purrr::set_names(unique(sce$CellType2))
kids

# Total number of clusters
nk <- length(kids)
nk

# Named vector of sample names
#sids <- purrr::set_names(levels(sce$orig.ident))
sids <- purrr::set_names(unique(sce$sample_id))

# Total number of samples 
ns <- length(sids)
ns

# Generate sample level metadata

## Determine the number of cells per sample
table(sce$sample_id)

## Turn named vector into a numeric vector of number of cells per sample
n_cells <- as.numeric(table(sce$sample_id))

## Determine how to reoder the samples (rows) of the metadata to match the order of sample names in sids vector
m <- match(sids, sce$sample_id)

## Create the sample level metadata by combining the reordered metadata with the number of cells corresponding to each sample.
ei <- data.frame(colData(sce)[m, ], 
                 n_cells, row.names = NULL) %>% 
  dplyr::select(-"cluster_id")
ei

ei <- ei[, colnames(ei) %in% c('sample_id', 'group_id')]

##load covariates
covariates <- read.csv('clinical/points.covariates.csv')
ei <- left_join(ei, covariates, by = "sample_id")
head(ei)

## Keep only needed columns
ei <- ei[, c("sample_id", "group_id", "FFM")]

## Remove missing FFM samples
ei <- ei %>% filter(!is.na(FFM))

## Set correct types
ei$group_id <- factor(ei$group_id)
ei$FFM <- as.numeric(ei$FFM)


# Subset metadata to only include the cluster and sample IDs to aggregate across
groups <- colData(sce)[, c("cluster_id", "sample_id")]

# Aggregate across cluster-sample groups
pb <- aggregate.Matrix(t(counts(sce)), 
                       groupings = groups, fun = "sum") 

class(pb)

dim(pb)

pb[1:6, 1:6]

#Not every cluster is present in all samples; create a vector that represents how to split samples
splitf <- sapply(stringr::str_split(rownames(pb), 
                                    pattern = "_",  
                                    n = 2), 
                 `[`, 1)

# Turn into a list and split the list into components for each cluster and transform, so rows are genes and columns are samples and make rownames as the sample IDs
pb <- split.data.frame(pb, 
                       factor(splitf)) %>%
  lapply(function(u) 
    set_colnames(t(u), 
                 stringr::str_extract(rownames(u), "(?<=_)[:alnum:]+")))

class(pb)

# Explore the different components of list
str(pb)


# Ensure your metadata is ready
metadata <- ei  # using your cleaned ei

dds_list <- list()  # to store DESeqDataSet objects per cluster

for (cluster_name in names(pb)) {
  
  # Get counts for cluster
  cluster_counts <- pb[[cluster_name]]
  
  # Subset metadata to samples present in this cluster
  cluster_metadata <- metadata %>%
    filter(sample_id %in% colnames(cluster_counts)) %>%
    filter(!is.na(FFM))
  
  # Skip cluster if no samples left after filtering
  if (nrow(cluster_metadata) == 0) {
    warning(paste0("No samples left for cluster: ", cluster_name, " after filtering"))
    next
  }
  
  # Reorder counts columns to match metadata rows
  cluster_counts <- cluster_counts[, cluster_metadata$sample_id]
  
 
  #  Round counts to whole numbers for DESeq2 (keep numeric type)
  cluster_counts@x <- round(cluster_counts@x)
  
  # Set rownames of metadata for DESeq2
  rownames(cluster_metadata) <- cluster_metadata$sample_id
  
  # Ensure covariates have correct type and group is factor
  cluster_metadata$FFM <- as.numeric(cluster_metadata$FFM)
  cluster_metadata$group_id <- factor(cluster_metadata$group_id)
  
  # Create DESeqDataSet object with design matrix
  dds <- DESeqDataSetFromMatrix(
    countData = cluster_counts,
    colData = cluster_metadata,
    design = ~ FFM + group_id
  )
  
  #  Store in list
  dds_list[[cluster_name]] <- dds
}

# Check how many DESeqDataSets were created
length(dds_list)
names(dds_list)

outdir <- "GroupDegs/Pseudobulk DEG w covariates"
dir.create(outdir, recursive = TRUE, showWarnings = FALSE)

smallestGroupSize <- 9  

for (cluster_name in names(dds_list)) {
  
  message("Running DESeq for: ", cluster_name)
  
  dds <- dds_list[[cluster_name]]
  
  # Remove zero genes 
  dds <- dds[rowSums(counts(dds)) > 0, ]
  
  # Filter low expressed genes
  keep <- rowSums(counts(dds) >= 1) >= smallestGroupSize
  dds <- dds[keep, ]
  
  if (nrow(dds) == 0) {
    warning("No genes left after filtering for cluster: ", cluster_name)
    next
  }
  
  # rlog transformation

  rld <- rlog(dds, blind = TRUE)
  rld_mat <- assay(rld)
  
  write.csv(
    rld_mat,
    file.path(outdir, paste0("normalized_", cluster_name, ".csv"))
  )
  
  # ---------------------------
  # Run DESeq
  # ---------------------------
  dds <- DESeq(dds)
  
  # Check group levels
  group_levels <- levels(colData(dds)$group_id)
  
  if (length(group_levels) < 2) {
    warning("Only one group present in cluster: ", cluster_name)
    next
  }
  
  contrast <- c("group_id",
                group_levels[2],
                group_levels[1])
  
  res <- results(dds, contrast = contrast, alpha = 0.05)
  
  # Safer lfcShrink (recommended method)
  coef_name <- resultsNames(dds)[grep("group_id", resultsNames(dds))]
  
  res2 <- lfcShrink(dds,
                    coef = coef_name[1],
                    type = "apeglm")
  
  # Order results
  res <- res[order(res$pvalue), ]
  res2 <- res2[order(res2$pvalue), ]
  
  # Convert to tables
  res_tbl <- as.data.frame(res) %>%
    rownames_to_column("gene")
  
  res_tbl2 <- as.data.frame(res2) %>%
    rownames_to_column("gene")
  
  # ---------------------------
  # Save results
  # ---------------------------
  write.csv(res_tbl,
            file.path(outdir, paste0(cluster_name, "_bulk_group.csv")),
            row.names = FALSE)
  
  write.csv(res_tbl2,
            file.path(outdir, paste0(cluster_name, "_bulk_lfc_shrink_group.csv")),
            row.names = FALSE)
  
}





