upregulated <- function(df, value){
  df <- subset(df, df$padj < 0.05 & df$log2FoldChange > value )
  return(df)
}

downregulated <- function(df, value){
  df <- subset(df, df$padj < 0.05 & df$log2FoldChange < value )
  return(df)
}

