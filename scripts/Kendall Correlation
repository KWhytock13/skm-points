##combine to make one plot
##make with top3
get_labels <- function(df){
  df <- subset(df, df$fdr < 0.4)
  labels <- df$label[1:3]
  return(labels)
}

process_neg <- function(df, CellType, Direction, labels){
  df$CellType <- CellType
  df$Direction <- Direction
  df <- df[df$label %in% labels, ]
  df$log10pvalue <- log10(df$pval)
  return(df)
}

process_pos <- function(df, CellType, Direction, labels){
  df$CellType <- CellType
  df$Direction <- Direction
  df <- df[df$label %in% labels, ]
  df$log10pvalue <- -log10(df$pval)
  return(df)
}

