organize <- function(df, CellType){
  df <- subset(df, df$Empirical_p_value < 0.05)
  df <- df %>% dplyr::select(1:2)
  colnames(df)[2] <- paste0(colnames(df), CellType)[2]
  df <- df[order(-df$tau),] 
  return(df)
}


EC <- organize(EC, 'EC')
Immune <- organize(Immune, 'Immune')
SMC_Pericytes <- organize(SMC_Pericytes, 'SMC_Pericytes')
FAP <- organize(FAP, 'FAP')
MuSC <- organize(MuSC, 'MuSC')
EGF <- organize(EGF, 'EGF')
CKM <- organize(CKM, 'CKM')
MYH7B <- organize(MYH7B, 'MYH7B')

