##run for each cell type
normalized_counts <- read.csv("GroupDegs/Pseudobulk DEG/normalized.counts.Immune.csv", row.names = 1)
normalized_counts[1:6, 1:6]
dim(normalized_counts)

CellType <- 'Immune'

###make sure trait data order matches with counts order
column_order <- colnames(normalized_counts)
clinical_data <- clinical_data[column_order,]

# Apply cor.test to each gene (row) in the gene expression matrix
cor_results <- apply(normalized_counts, 1, function(gene_expr_values) {
  cor.test(gene_expr_values, clinical_data$RdSS2kgFFMInsulin_Pre, method = 'kendall')  # Perform correlation test
})

# View results for the first gene
cor_results[[1]]


# Extract correlation coefficients and p-values
cor_coeffs <- sapply(cor_results, function(res) res$estimate)  #  correlation coefficient
p_values <- sapply(cor_results, function(res) res$p.value)    # p-values

# Combine results into a data frame
correlation_df <- data.frame(
  Gene = rownames(normalized_counts),
  tau = cor_coeffs,
  P_value = p_values
)

head(correlation_df)

write.csv(correlation_df, file=paste0('Correlation/', CellType,  '.kendall.correlation.csv'))

