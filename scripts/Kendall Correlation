###calculate emperical P values for each gene that passes P < 0.05
sig_gene <- function(df){
  df <- subset(df, df$P_value < 0.05 )
  genes <- df$Gene
  return(genes)
}

siggene <- sig_gene(Immune)
normalized_counts <- read.csv("GroupDegs/Pseudobulk DEG/normalized.counts.Immune.csv", row.names = 1)
normalized_counts[1:6, 1:6]
normalized_counts <- normalized_counts[rownames(normalized_counts) %in% siggene, ]

###make sure trait data order matches with counts order
column_order <- colnames(normalized_counts)
clinical_data <- clinical_data[column_order,]


# Set parameters for permutation
n_permutations <- 1000  # Number of permutations

# Initialize an empty list to store the permutation results
permuted_correlations <- matrix(NA, nrow = n_permutations, ncol = nrow(normalized_counts))

# Compute the original correlations, ##this will match the original correlation but has just been re-run on significant genes
original_correlations <- apply(normalized_counts, 1, function(gene_expr_values) {
  cor.test(gene_expr_values, clinical_data$RdSS2kgFFMInsulin_Pre, method = 'kendall')$estimate
})

# Perform the permutation procedure
for (i in 1:n_permutations) {
  # Permute the RdSS2kgFFMInsulin_Pre values
  permuted_labels <- sample(clinical_data$RdSS2kgFFMInsulin_Pre)
  
  # Compute the Kendall correlation between the gene expression and permuted labels
  permuted_correlations[i, ] <- apply(normalized_counts, 1, function(gene_expr_values) {
    cor.test(gene_expr_values, permuted_labels, method = 'kendall')$estimate
  })
}

# Calculate empirical p-values for each gene
empirical_p_values <- apply(permuted_correlations, 2, function(permuted_corrs, original_corrs) {
  # Calculate how often the permuted correlations are as extreme as the original correlation
  mean(abs(permuted_corrs) >= abs(original_corrs))  # Two-tailed test
}, original_corrs = original_correlations)

# Output the empirical p-values
empirical_p_values
max(empirical_p_values)
min(empirical_p_values)

# Create a data frame to store gene names and their corresponding empirical p-values
gene_p_values <- data.frame(
  Gene = rownames(normalized_counts),  # Gene names (assuming genes are the row names of normalized_counts)
  Empirical_p_value = empirical_p_values
)

# Output the data frame with gene names and empirical p-values
head(gene_p_values)  # Print the first few rows
df2 <- left_join(MYH7B, gene_p_values, by = 'Gene')

write.csv(df2, 'Correlation/Immune.kendall.adjusted.csv')

