pos_cor <- function(df, tau_val){
  df <- subset(df, df$Empirical_p_value < 0.05 & df$tau > tau_val)
  df <- df[order(-df$tau),] 
  return(df)
}

neg_cor <- function(df, tau_val){
  df <- subset(df, df$Empirical_p_value < 0.05 & df$tau < tau_val)
  df <- df[order(df$tau),] 
  return(df)
}

ECpos <- pos_cor(EC, 0)
ECneg <- neg_cor(EC, 0)

SMC_Pericytespos <- pos_cor(SMC_Pericytes, 0)
SMC_Pericytesneg <- neg_cor(SMC_Pericytes, 0)

Immunepos <- pos_cor(Immune, 0)
Immuneneg <- neg_cor(Immune, 0)

MuSCpos <- pos_cor(MuSC, 0)
MuSCneg <- neg_cor(MuSC, 0)

FAPpos <- pos_cor(FAP, 0)
FAPneg <- neg_cor(FAP, 0)

CKMpos <- pos_cor(CKM, 0)
CKMneg <- neg_cor(CKM, 0)

MYH7Bpos <- pos_cor(MYH7B, 0)
MYH7Bneg <- neg_cor(MYH7B, 0)

EGFpos <- pos_cor(EGF, 0)
EGFneg <- neg_cor(EGF, 0)

