outdir <- "GroupDegs/Pseudobulk DEG 2"
dir.create(outdir, recursive = TRUE, showWarnings = FALSE)

run_cluster_deseq <- function(cluster_name, pb, metadata, smallestGroupSize = 9){
  
  message("Running cluster: ", cluster_name)
  
  # Subset metadata
  cluster_metadata <- metadata %>%
    dplyr::filter(cluster_id == cluster_name)
  
  cluster_metadata$group_id <- factor(cluster_metadata$group_id)
  
  rownames(cluster_metadata) <- cluster_metadata$sample_id
  
  # Subset counts
  counts_mat <- pb[[cluster_name]]
  cluster_counts <- round(
    data.frame(counts_mat[, colnames(counts_mat) %in% rownames(cluster_metadata)])
  )
  
  # Remove zero genes
  cluster_counts <- cluster_counts[rowSums(cluster_counts) > 0, ]
  
  # Match order
  cluster_counts <- cluster_counts[, rownames(cluster_metadata)]
  stopifnot(all(rownames(cluster_metadata) == colnames(cluster_counts)))
  
  # Create DESeq object
  dds <- DESeqDataSetFromMatrix(cluster_counts,
                                colData = cluster_metadata,
                                design = ~ group_id)
  
  # Filter low-count genes
  keep <- rowSums(counts(dds) >= 1) >= smallestGroupSize
  dds <- dds[keep,]
  
  # rlog transform
  rld <- rlog(dds, blind = TRUE)
  rld_mat <- assay(rld)
  
  # Save normalized matrix
  write.csv(rld_mat,
            file.path(outdir, paste0("normalized_", cluster_name, ".csv")))
  
  # Run DESeq
  dds <- DESeq(dds)
  
  contrast <- c("group_id",
                levels(cluster_metadata$group_id)[2],
                levels(cluster_metadata$group_id)[1])
  
  res <- results(dds, contrast = contrast, alpha = 0.05)
  res2 <- lfcShrink(dds, coef = 2, res = res)
  
  res <- res[order(res$pvalue),]
  res2 <- res2[order(res2$pvalue),]
  
  # Convert to tables
  res_tbl <- as.data.frame(res) %>%
    tibble::rownames_to_column("gene")
  
  res_tbl2 <- as.data.frame(res2) %>%
    tibble::rownames_to_column("gene")
  
  # Save full results
  write.csv(res_tbl,
            paste0(outdir, "/", cluster_name, "_bulk_group.csv"),
            row.names = FALSE)
  
  write.csv(res_tbl2,
            paste0(outdir, "/", cluster_name, "_bulk_lfc_shrink_group.csv"),
            row.names = FALSE)
  
  
#saved significant genes
  
  padj_cutoff <- 0.05
  
  sig_res <- res_tbl %>%
    dplyr::filter(padj < padj_cutoff) %>%
    dplyr::arrange(padj)
  
  write.csv(sig_res,
            paste0(outdir, "/", cluster_name, "_significant_genes.csv"),
            row.names = FALSE)
  
#saved normalized counts  

  normalized_counts <- counts(dds, normalized = TRUE)
  
  write.csv(normalized_counts,
            paste0(outdir, "/", cluster_name, "_normalized_counts.csv"))
  

}


lapply(clusters, run_cluster_deseq, pb = pb, metadata = metadata)


