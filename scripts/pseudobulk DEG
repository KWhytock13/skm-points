###Run ORA TMsig for each cell type on GO:BP
geneSets <- gmtPathways('MsigDB/c5.go.bp.v2024.1.Hs.symbols.gmt')

outdir <- "GroupDegs/Pseudobulk DEG 2/ORA"
dir.create(outdir, recursive = TRUE, showWarnings = FALSE)

run_tmSig_ORA <- function(cluster_name, deg_dir){
  
  message("Running ORA for: ", cluster_name)
  
  # ---------------------------
  # Load DEG results
  # ---------------------------
  
  file_path <- file.path(deg_dir,
                         paste0(cluster_name, "_bulk_group.csv"))
  
  if(!file.exists(file_path)){
    message("Skipping ", cluster_name, " — DEG file not found.")
    return(NULL)
  }
  
  deg <- read.csv(file_path, row.names = 1)
  
  # Background genes
  background_genes <- rownames(deg)
  
  # ---------------------------
  # Define significant gene lists
  # ---------------------------
  
  deg$gene <- rownames(deg)
  
  up_genes <- deg %>%
    filter(padj < 0.05 & log2FoldChange > 0) %>%
    pull(gene)
  
  down_genes <- deg %>%
    filter(padj < 0.05 & log2FoldChange < 0) %>%
    pull(gene)
  
  if(length(up_genes) < 10 & length(down_genes) < 10){
    message("Skipping ", cluster_name, " — not enough significant genes.")
    return(NULL)
  }
  
  # ---------------------------
  # Filter Gene Sets by Background
  # ---------------------------
  
  geneSetsFilt <- filterSets(
    x = geneSets,
    background = background_genes,
    min_size = 10L
  )
  
  # Keep sets with ≥80% overlap
  setSizes <- lengths(geneSetsFilt)
  setSizesOld <- lengths(geneSets)[names(geneSetsFilt)]
  overlapProp <- setSizes / setSizesOld
  
  geneSetsFilt <- geneSetsFilt[overlapProp >= 0.8]
  
  if(length(geneSetsFilt) == 0){
    message("Skipping ", cluster_name, " — no gene sets passed filtering.")
    return(NULL)
  }
  
  # ---------------------------
  # Cluster Similar Sets
  # ---------------------------
  
  clusterDF <- clusterSets(
    x = geneSetsFilt,
    type = "jaccard",
    cutoff = 0.85,
    method = "complete",
    h = 0.9
  )
  
  clusterDF$overlap_prop <- overlapProp[clusterDF$set]
  clusterDF$n_char <- nchar(clusterDF$set)
  
  o <- with(clusterDF,
            order(cluster, set_size, overlap_prop, n_char, set,
                  decreasing = c(FALSE, TRUE, TRUE, FALSE, TRUE),
                  method = "radix"))
  
  clusterDF <- clusterDF[o, ]
  
  keepSets <- with(clusterDF, set[!duplicated(cluster)])
  
  geneSetsFilt <- geneSetsFilt[keepSets]
  
  # ---------------------------
  # Run ORA
  # ---------------------------
  
  if(length(up_genes) >= 10){
    M_up <- hypeR(
      up_genes,
      geneSetsFilt,
      test = "hypergeometric",
      background = background_genes,
      absolute = FALSE,
      pval = 0.05
    )
    
    hyp_to_excel(
      M_up,
      file_path = file.path(outdir,
                            paste0(cluster_name, ".Up.GO_BP.xlsx"))
    )
  }
  
  if(length(down_genes) >= 10){
    M_down <- hypeR(
      down_genes,
      geneSetsFilt,
      test = "hypergeometric",
      background = background_genes,
      absolute = FALSE,
      pval = 0.05
    )
    
    hyp_to_excel(
      M_down,
      file_path = file.path(outdir,
                            paste0(cluster_name, ".Down.GO_BP.xlsx"))
    )
  }
}

clusters

lapply(clusters, run_tmSig_ORA,
       deg_dir = "GroupDegs/Pseudobulk DEG 2")

