##run correlations for all different interactions
#run cor.test() only if enough finite, non-NA values exist (e.g., at least 3 paired observations):
# Group by source, target, ligand, and receptor

# Step 1: Average or collapse per interaction per sample
collapsed_df <- comm_all %>%
  group_by(source, target, ligand, receptor, sample) %>%
  dplyr::summarise(
    prob = mean(prob, na.rm = TRUE),
    RdSS2kgFFMInsulin_Pre = mean(RdSS2kgFFMInsulin_Pre, na.rm = TRUE),
    .groups = "drop"
  )
head(collapsed_df)

head(comm_all)
collapsed_df <- comm_all %>%
  group_by(source, target, ligand, receptor, sample) %>%
  summarise(
    prob = mean(prob, na.rm = TRUE),
    RdSS2kgFFMInsulin_Pre = mean(RdSS2kgFFMInsulin_Pre, na.rm = TRUE)
  ) %>%
  ungroup()

head(collapsed_df)


# Filter interactions with mostly zero values
filtered <- collapsed_df %>%
  group_by(source, target, ligand, receptor) %>%
  filter(sum(prob > 0, na.rm = TRUE) >= 6)  # Keep only if ≥ 6 non-zero prob values
dim(filtered)

# Step 2: Correlation test per interaction (across samples)
nested_corr <- filtered  %>%
  group_by(source, target, ligand, receptor) %>%
  nest() %>%
  mutate(
    n = map_int(data, ~ sum(is.finite(.x$prob) & is.finite(.x$RdSS2kgFFMInsulin_Pre))),
    cor_test = map2(data, n, ~ if (.y >= 3) cor.test(.x$prob, .x$RdSS2kgFFMInsulin_Pre, method = "pearson") else NA),
    estimate = map_dbl(cor_test, ~ if (is.list(.x)) .x$estimate else NA_real_),
    p.value  = map_dbl(cor_test, ~ if (is.list(.x)) .x$p.value  else NA_real_)
  ) %>%
  dplyr::select(source, target, ligand, receptor, n, estimate, p.value)


# View top significant correlations
head(nested_corr)

# View valid results
nested_corr <- nested_corr %>% filter(!is.na(p.value)) 
sig_corr <- subset(nested_corr, p.value < 0.05)
dim(sig_corr)

sig_corr <- sig_corr[order(-sig_corr$estimate),] 
view(sig_corr)
tail(sig_corr)

write.csv(sig_corr, 'cellChat/interaction_probability_Rd.I.correlation.csv')
sig_corr <- read.csv('cellChat/interaction_probability_Rd.I.correlation.csv')


