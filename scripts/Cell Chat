setwd("~/OneDrive - AdventHealth/Clinical Studies Projects/Points/Data")
seurat <- readRDS('Integration/Points.harmony.sct.RDS')

Idents(seurat) = seurat$CellType2

##create cell chat
cellchat <- createCellChat(object = seurat, group.by = "ident", assay = "RNA")

CellChatDB <- CellChatDB.human 
showDatabaseCategory(CellChatDB)

# use all CellChatDB for cell-cell communication analysis
 CellChatDB.use <- CellChatDB

# set the used database in the object
cellchat@DB <- CellChatDB.use

##preprocessing
cellchat <- subsetData(cellchat)

##run each sample individually
seurat.list <- SplitObject(seurat, split.by = "samples")


cellchat.list <- lapply(names(seurat.list), function(s) {
  seu <- seurat.list[[s]]
  Idents(seu) <- seu$CellType2
  chat <- createCellChat(object = seu, group.by = "ident", assay = "RNA")
  chat@DB <- CellChatDB.human
  chat <- subsetData(chat)
  chat <- identifyOverExpressedGenes(chat)
  chat <- identifyOverExpressedInteractions(chat)
  chat <- computeCommunProb(chat)
  chat <- filterCommunication(chat, min.cells = 10)
  chat <- computeCommunProbPathway(chat)
  chat <- aggregateNet(chat)
  return(chat)
})
names(cellchat.list) <- names(seurat.list)
saveRDS(cellchat.list, 'cellchat.list.RDS')

##this function will calculate non-significant interactions and access pval, 
## add bootstrapping via computeCommunProb by setting the raw.use = TRUE 
#and including the number of bootstraps with nboot.
cellchat.list <- lapply(names(seurat.list), function(s) {
  seu <- seurat.list[[s]]
  Idents(seu) <- seu$CellType2
  chat <- createCellChat(object = seu, group.by = "ident", assay = "RNA")
  chat@DB <- CellChatDB.human
  chat <- subsetData(chat)
  chat <- identifyOverExpressedGenes(chat)
  chat <- identifyOverExpressedInteractions(chat)
  chat <- computeCommunProb(chat, raw.use = TRUE, nboot = 100)  # includes p-values
  chat <- filterCommunication(chat, min.cells = 10)
  chat <- computeCommunProbPathway(chat)
  chat <- aggregateNet(chat)
  return(chat)
})

names(cellchat.list) <- names(seurat.list)
saveRDS(cellchat.list, 'cellchat.list.V2.RDS')
cellchat.list <- readRDS('cellchat.list.V2.RDS')

##organize results

comm_list <- lapply(names(cellchat.list), function(samp) {
  mat <- cellchat.list[[samp]]@net$prob
  pval_mat <- cellchat.list[[samp]]@net$pval
  
  df <- melt(mat, varnames = c("source", "target", "interaction_name"), value.name = "prob")
  df_pval <- melt(pval_mat, varnames = c("source", "target", "interaction_name"), value.name = "pval")
  
  df <- left_join(df, df_pval, by = c("source", "target", "interaction_name"))
  
  # Add sample column
  df$sample <- samp
  
  # Add pathway name and split LR
  df <- df %>%
    mutate(
      ligand = gsub("_.*", "", interaction_name),
      receptor = gsub(".*?_", "", interaction_name),  # everything after first "_"
      pathway_name = cellchat.list[[samp]]@LR$pathway_name[match(interaction_name, cellchat.list[[samp]]@LR$interaction_name)]
    )
  
  return(df)
})

comm_all <- do.call(rbind, comm_list)

head(comm_all)

subset(comm_all, pval > 0.05)

table(comm_all$pval <= 0.05)

##Add insulin resistance data

head(seurat@meta.data)
cols <- c('orig.ident', "RdSS2kgFFMInsulin_Pre")
df <-  unique(seurat@meta.data[,  colnames(seurat@meta.data) %in% cols]  %>% remove_rownames)

comm_all <- left_join(comm_all, df, by = 'orig.ident')
head(comm_all)



EGF <- subset(comm_all, ligand == 'EGF')
str(EGF)

EGF2 <- subset(EGF, source == 'EGF+ Myonuclei')

# 1. Subset just the rows of interest (optional, or skip if you want all)
# For example: only receptor == "EGFR"
subset_df <- EGF2 %>%
  filter(receptor == "EGFR") # add more filters as needed (e.g. ligand == "EGF")



# 2. Nest by receptor and target
nested_df <- subset_df %>%
  group_by(receptor, target) %>%
  nest()

# 3. Run correlation on each subgroup
results <- nested_df %>%
  mutate(cor_test = map(data, ~ cor.test(.x$prob, .x$RdSS2kgFFMInsulin_Pre, method = "pearson"))) %>%
  mutate(
    estimate = map_dbl(cor_test, ~ .x$estimate),
    p.value  = map_dbl(cor_test, ~ .x$p.value)
  ) %>%
  dplyr::select(receptor, target, estimate, p.value)

# View results
print(results)

plot_df <- EGF2 %>%
  filter(target == "Immune", receptor == "EGFR", ligand == "EGF")

