collapsed_df <- collapsed_df %>%
  mutate(Group = case_when(
    grepl("^CON_", sample) ~ "CON",
    grepl("^T2D_", sample) ~ "T2D",
    TRUE ~ NA_character_
  ))

##plot some key variable
egf_subset <- collapsed_df %>%
  filter(
    ligand == "EGF",
    receptor == "EGFR",
    source == "EGF+ Myonuclei",
    target == "Immune"
  )

cor.test(egf_subset$prob, egf_subset$RdSS2kgFFMInsulin_Pre, method = "pearson")


plot3 <- ggplot(egf_subset, aes(x = prob, y = RdSS2kgFFMInsulin_Pre, color = Group)) + 
  geom_point() +
