 # Vector of all conditions (must match big_df$condition and your *_pos_genes objects)
 
 pos_cor <- function(df, celltype, tau_val){
   df <- subset(df, condition == celltype)
   df <- subset(df, df$empirical_p < 0.05 & df$tau > tau_val)
   df <- df[order(-df$tau),] 
   return(df)
 }
 
 neg_cor <- function(df, celltype, tau_val){
   df <- subset(df, condition == celltype)
   df <- subset(df, df$empirical_p< 0.05 & df$tau < tau_val)
   df <- df[order(df$tau),] 
   return(df)
 }
 
 unique(big_df$condition)
 
 Myeloid_pos <- pos_cor(big_df, 'Myeloid', 0)
 Myeloid_neg <- neg_cor(big_df, 'Myeloid', 0)
 
 Lymphoid_pos <- pos_cor(big_df, 'Lymphoid', 0)
 Lymphoid_neg <- neg_cor(big_df, 'Lymphoid', 0)
 
 Myeloid_pos_genes <- Myeloid_pos$gene
 Myeloid_neg_genes <- Myeloid_neg$gene
 
 Lymphoid_pos_genes <- Lymphoid_pos$gene
 Lymphoid_neg_genes <- Lymphoid_neg$gene
 
 background_Lymphoid <- big_df %>% filter(condition == "Lymphoid") %>% pull(gene) %>% unique()
 background_Myeloid <- big_df %>% filter(condition == "Myeloid") %>% pull(gene) %>% unique()
 
 
 cell_types <- c('Myeloid', 'Lymphoid')
 
 # Load MSigDB gene sets once
 geneSets <- gmtPathways("MsigDB/c5.go.bp.v2024.1.Hs.symbols.gmt")
 
 # Loop over each cell type
 for (ct in cell_types) {
   message("Processing: ", ct)
   
   # Background genes for this condition
   background_genes <- big_df %>% 
     filter(condition == ct) %>% 
     pull(gene) %>% 
     unique()
   
   # Filter gene sets by background
   geneSetsFilt <- filterSets(
     x = geneSets, 
     background = background_genes,
     min_size = 10L
   )
   
   # Calculate overlap proportion
   setSizes <- lengths(geneSetsFilt)
   setSizesOld <- lengths(geneSets)[names(geneSetsFilt)]
   overlapProp <- setSizes / setSizesOld
   geneSetsFilt <- geneSetsFilt[overlapProp >= 0.8]
   
   # Cluster sets to remove redundancy
   imat <- sparseIncidence(geneSetsFilt)
   jaccard <- similarity(x = geneSetsFilt)
   clusterDF <- clusterSets(
     x = geneSetsFilt, type = "jaccard", 
     cutoff = 0.85, method = "complete", h = 0.9
   )
   
   # Add metadata for selection
   clusterDF$overlap_prop <- overlapProp[clusterDF$set]
   clusterDF$n_char <- nchar(clusterDF$set)
   o <- with(clusterDF,
             order(cluster, -set_size, -overlap_prop, n_char, set))
   clusterDF <- clusterDF[o, ]
   keepSets <- with(clusterDF, set[!duplicated(cluster)])
   geneSetsFilt <- geneSetsFilt[keepSets]
   
   
   # Get gene lists you already defined (e.g., Immune_pos_genes)
   pos_genes <- get(paste0(ct, "_pos_genes"))
   neg_genes <- get(paste0(ct, "_neg_genes"))
   
   # Run hypergeometric enrichment
   M1 <- hypeR(pos_genes, geneSetsFilt, test="hypergeometric", 
               background = background_genes, absolute = FALSE, pval = 0.05)
   M2 <- hypeR(neg_genes, geneSetsFilt, test="hypergeometric", 
               background = background_genes, absolute = FALSE, pval = 0.05)
   
   # Save results to Excel
   hyp_to_excel(M1, file_path = paste0("EGF+ correlations/ORA after TMsig/", ct, 'EGF_Score', ".pos.BP.xlsx"))
   hyp_to_excel(M2, file_path = paste0("EGF+ correlations/ORA after TMsig/", ct, 'EGF_Score', ".neg.BP.xlsx"))
 }
 
 
 Lymphoid_BP_pos <- read_excel('EGF+ correlations/ORA after TMsig/LymphoidEGF_Score.pos.BP.xlsx')
 Lymphoid_BP_neg <- read_excel('EGF+ correlations/ORA after TMsig/LymphoidEGF_Score.neg.BP.xlsx')
 Myeloid_BP_pos <- read_excel('EGF+ correlations/ORA after TMsig/MyeloidEGF_Score.pos.BP.xlsx')
 Myeloid_BP_neg <- read_excel('EGF+ correlations/ORA after TMsig/MyeloidEGF_Score.neg.BP.xlsx')
 
