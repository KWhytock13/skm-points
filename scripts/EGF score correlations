tab$SampleID <- factor(tab$SampleID, levels = column_order)
# Reorder the table
tab <- tab[order(tab$SampleID), ]


# Path to folder
folder <- "~/Library/CloudStorage/OneDrive-AdventHealth/Clinical Studies Projects/Points/Data/GroupDegs/Pseudobulk DEG/"

# List all pseudobulk count files
files <- list.files(
  folder,
  pattern = "^normalized\\.counts.*\\.csv$",
  full.names = TRUE
)

all_results <- vector("list", length(files))
names(all_results) <- basename(files)

# Number of permutations
n_permutations <- 1000

# Optional: makes permutations reproducible
set.seed(123)

for (i in seq_along(files)) {
  
  f <- files[i]
  message("Processing: ", f)
  
  # Get cell-type name from filename

  stem <- basename(f)
  stem_no_ext <- sub("\\.csv$", "", stem, ignore.case = TRUE)
  
  condition <- sub(
    "^normalized\\.counts\\.",
    "",
    stem_no_ext,
    ignore.case = TRUE
  )
  

  # Read pseudobulk expression

  normalized_counts <- read.csv(
    f,
    row.names = 1,
    check.names = FALSE
  )
  
  # Align EGF score/proportion to expression matrix columns
  tab_sub <- tab[
    match(colnames(normalized_counts), as.character(tab$SampleID)),
    ,
    drop = FALSE
  ]
  
  prop_vec <- tab_sub$EGF_Score
  
  # Remove samples missing EGF score
  keep <- which(!is.na(prop_vec))
  
  if (length(keep) < 3L) {
    warning(
      "Too few samples with non-NA EGF_Score for ",
      condition,
      " — skipping."
    )
    next
  }
  
  prop_vec <- prop_vec[keep]
  
  expr_mat <- as.matrix(
    normalized_counts[, keep, drop = FALSE]
  )
  

  # Observed Kendall correlation

  kendall_tau <- apply(expr_mat, 1, function(g) {
    
    ok <- complete.cases(g, prop_vec)
    
    if (sum(ok) < 3L)
      return(NA_real_)
    
    suppressWarnings(
      cor.test(
        g[ok],
        prop_vec[ok],
        method = "kendall"
      )$estimate
    )
  })
  
  kendall_p <- apply(expr_mat, 1, function(g) {
    
    ok <- complete.cases(g, prop_vec)
    
    if (sum(ok) < 3L)
      return(NA_real_)
    
    suppressWarnings(
      cor.test(
        g[ok],
        prop_vec[ok],
        method = "kendall"
      )$p.value
    )
  })
  

  # Initial results

  df <- tibble(
    gene = rownames(expr_mat),
    tau = as.numeric(kendall_tau),
    pval = as.numeric(kendall_p)
  )
  

  # Only calculate empirical p-values for nominal P < 0.05

  sig_idx <- which(!is.na(df$pval) & df$pval < 0.05)
  
  # Initialize empirical p-value column
  empirical_p <- rep(NA_real_, nrow(df))
  
  if (length(sig_idx) > 0) {
    
    message(
      "  Running permutations for ",
      length(sig_idx),
      " genes in ",
      condition
    )
    
    # Only keep significant genes for permutation
    sig_expr <- expr_mat[sig_idx, , drop = FALSE]
    
    observed_tau <- df$tau[sig_idx]
    
    # Matrix:
    # rows = permutations
    # columns = genes
    permuted_correlations <- matrix(
      NA_real_,
      nrow = n_permutations,
      ncol = nrow(sig_expr)
    )
    

    # Permutations

    for (p in seq_len(n_permutations)) {
      
      permuted_prop <- sample(prop_vec)
      
      permuted_correlations[p, ] <- apply(
        sig_expr,
        1,
        function(g) {
          
          ok <- complete.cases(g, permuted_prop)
          
          if (sum(ok) < 3L)
            return(NA_real_)
          
          suppressWarnings(
            cor(
              g[ok],
              permuted_prop[ok],
              method = "kendall"
            )
          )
        }
      )
    }
    

    # Empirical two-sided p-values

    empirical_p_sig <- sapply(
      seq_along(observed_tau),
      function(j) {
        
        perm_tau <- permuted_correlations[, j]
        
        perm_tau <- perm_tau[!is.na(perm_tau)]
        
        if (length(perm_tau) == 0)
          return(NA_real_)
        
        # +1 correction prevents P = 0
        (
          sum(abs(perm_tau) >= abs(observed_tau[j])) + 1
        ) /
          (
            length(perm_tau) + 1
          )
      }
    )
    
    empirical_p[sig_idx] <- empirical_p_sig
  }

  # Add empirical p-values and multiple-testing corrections

  df <- df %>%
    mutate(
      empirical_p = empirical_p,
      
      # FDR based on nominal Kendall p-values
      padj = p.adjust(
        pval,
        method = "BH"
      ),
      
      # Optional empirical FDR
      empirical_padj = p.adjust(
        empirical_p,
        method = "BH"
      ),
      
      condition = condition
    ) %>%
    arrange(desc(abs(tau)))
  
  all_results[[i]] <- df
}

# Combine all cell types

big_df <- bind_rows(all_results) %>%
  relocate(condition, .after = gene)

head(big_df)






