##subset just CKM myonuclei and classify them as TypeI, IIA and IIx based on MYH expression
#Calculate Type I and Type II score to classify each of them. Next, calculate Type IIa and Type IIx scores to further discriminate Type II fiber types
Myo <- subset(seurat, idents = c('CKM+ Myonuclei'))


Myo$scoreI  <- PercentageFeatureSet(object = Myo, pattern = "MYH7")
Myo$scoreII  <- PercentageFeatureSet(object = Myo, pattern = "MYH1|MYH2")
Myo$scoreIIa  <- PercentageFeatureSet(object = Myo, pattern  = "MYH2")
Myo$scoreIIx  <- PercentageFeatureSet(object = Myo, pattern = "MYH1")

I <- Myo$scoreI
II <- Myo$scoreII
IIa <- Myo$scoreIIa
IIx <- Myo$scoreIIx

Myo$IorII <- I/II #if greater than 1 more TypeI than TypeII
Myo$IIclass <- IIx/IIa #if greater than 1 more IIx than IIa
Myo$fiber_class <- Myo@meta.data$CellType2

i <- 1
for(i in 1:length(rownames(Myo@meta.data))){
  x <- Myo@meta.data$IorII[i]
  z <- Myo@meta.data$scoreIIa[i]
  y <- Myo@meta.data$IIclass[i]
  if(x == "NaN"){
    Myo@meta.data$fiber_class[i] <- "Unknown MF" ##if values are NaN identifies as unknwon
  }else if(x == "Inf"){
    Myo@meta.data$fiber_class[i] <- "Pure Type I"  #if value is infinity identifies as pure TypeI
  }else if(x > 1){
    if(z < 1){
      Myo@meta.data$fiber_class[i] <- "Type I" #If x(I/II) is greater than 1 checks if score IIa is less than 1 and if so assigns as TypeI
    }else{
      Myo@meta.data$fiber_class[i] <- "Hybrid I/IIa" ##If scoreIIa greater than 1 assigns it is as hybird I/IIa
    }
  }else{ ##If IorII is not greater than 1 (less than 1) it will be a typeII fibers
    if(y == "NaN"){
      Myo@meta.data$fiber_class[i] <- "Unknown II" ##if the ratio between IIx/IIa is NAN it classifies as unknown II
    }else if(y == "Inf"){
      Myo@meta.data$fiber_class[i] <- "Pure Type IIx" ##If IIX/IIa is infinite it assigns it pure IIx
    }else if(y == 0){
      Myo@meta.data$fiber_class[i] <- "Type IIa" ##If IIx/IIa is 0 it is assigned pure IIa changed from pure IIa
    }else if(y > 1.25){
      Myo@meta.data$fiber_class[i] <- "Type IIx" ##If IIX/IIA is greater than 1.25 it assigns it typeIIx
    }else if(y < 0.75){
      Myo@meta.data$fiber_class[i] <- "Type IIa" ##If IIx/IIa is less than 0.75 it assigns it TypeIIa
    }else if(y < 1.25 & y > 0.75){
      Myo@meta.data$fiber_class[i]  <- "Hybrid IIa/IIx" #If IIX/IIa is between 0.75 and 1.25 it is hybird IIA/IIx
    }else{
      Myo@meta.data$fiber_class[i] <- "Unknown II-subtype" #If is doesn't meet any of these criteria, it is unknown subtype IIa
    }
  }
}


x <- Idents(Myo)
Idents(Myo) <- Myo$fiber_class
