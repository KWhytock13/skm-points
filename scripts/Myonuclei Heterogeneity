background <- unique(c(backgroundEGF, backgroundCKM, backgroundMYH7B))

###run pathway analyses using TMsig 
##Load GO:BP pathays from MsigDB
geneSets <- gmtPathways('MsigDB/c5.go.bp.v2024.1.Hs.symbols.gmt')
length(geneSets) 

# Filter by size - no background
# Restrict genes sets to background of genes
##Will need to repeat this for each celltype
geneSetsFilt <- filterSets(
  x = geneSets, 
  background = background,
  min_size = 10L # min. overlap of each set with background
)

length(geneSetsFilt) 

# Calculate proportion of overlap with background
setSizes <- lengths(geneSetsFilt)
setSizesOld <- lengths(geneSets)[names(geneSetsFilt)]
overlapProp <- setSizes / setSizesOld

plot(setSizesOld, overlapProp, main = "Set Size vs. Overlap")
table(overlapProp >= 0.8)

geneSetsFilt <- geneSetsFilt[overlapProp >= 0.8]
length(geneSetsFilt) 

#Incidence Matrix
imat <- sparseIncidence(x = geneSetsFilt)
dim(imat) 

imat[seq_len(8L), seq_len(5L)]
# Calculate sizes of all pairwise intersections
tcrossprod(imat)[1:3, 1:3]
crossprod(imat)[1:3, 1:3]

#Set similarity
##Jaacard
jaccard <- similarity(x = geneSetsFilt)
dim(jaccard)
class(jaccard)


##Cluster similar sets
# clusterSets with default arguments
clusterDF <- clusterSets(x = geneSetsFilt, 
                         type = "jaccard", 
                         cutoff = 0.85, 
                         method = "complete",
                         h = 0.9)

# First 4 clusters with 2 or more sets
subset(clusterDF, subset = cluster <= 4L)

##In each cluster, a single set can be retained for analysis using a combination of criteria such as set size, 
#overlap proportion, or length of the description (shorter descriptions tend to be more general terms).

## Use clusterSets output to select sets to retain for analysis
clusterDF$overlap_prop <- overlapProp[clusterDF$set] # overlap proportion
clusterDF$n_char <- nchar(clusterDF$set) # length of set description

# Reorder rows so that the first set in each cluster is the one to keep
o <- with(clusterDF, 
          order(cluster, set_size, overlap_prop, n_char, set,
                decreasing = c(FALSE, TRUE, TRUE, FALSE, TRUE),
                method = "radix"))
clusterDF <- clusterDF[o, ]

subset(clusterDF, cluster <= 4L) # show first 4 cluste


# Sets to keep for analysis
keepSets <- with(clusterDF, set[!duplicated(cluster)])
head(keepSets, 4L)


# Subset geneSetsFilt to those sets
geneSetsFilt <- geneSetsFilt[keepSets]
length(geneSetsFilt) 

##run ORA on hypeR
M1 <- hypeR(EGF_Up_Genes, geneSetsFilt, test="hypergeometric", background = background, absolute = FALSE, pval = 0.05)
hyp_dots(M1 , merge=TRUE, top = 25, pval = 0.05) 

M2 <- hypeR(CKM_Myo_Up_Genes, geneSetsFilt, test="hypergeometric", background = background, absolute = FALSE, pval = 0.05)
hyp_dots(M2 , merge=TRUE, top = 25, pval = 0.05) 

M3 <- hypeR(MYH7B_Myo_Up_Genes, geneSetsFilt, test="hypergeometric", background = background, absolute = FALSE, pval = 0.05)
hyp_dots(M3 , merge=TRUE, top = 25, pval = 0.05) 

M4 <- hypeR(EGFvMYH7B_Up_Genes, geneSetsFilt, test="hypergeometric", background = background, absolute = FALSE, pval = 0.05)
hyp_dots(M4 , merge=TRUE, top = 25, pval = 0.05) 

M5 <- hypeR(EGFvMYH7B_Down_Genes, geneSetsFilt, test="hypergeometric", background = background, absolute = FALSE, pval = 0.05)
hyp_dots(M5 , merge=TRUE, top = 25, pval = 0.05) 


