###Run TMSig ORA on myonuclei populations
EGF_Myo <- FindMarkers(seurat, ident.1 = "EGF+ Myonuclei", ident.2 = c("CKM+ Myonuclei", "MYH7B+ Myonuclei"), min.pct = 0.1,  logfc.threshold = 0.25, only.pos = FALSE)
